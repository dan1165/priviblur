{%extends "base.jinja"%}

{% block title -%}
    {%- if blog_info.title -%}
        {{blog_info.title | e}}
    {%- else -%}
        {{blog_info.name | e}}
    {%- endif -%}
{% endblock %}

{% block center %}
    <h1 class="visually-hidden">{% if blog_info.title %}{{blog_info.title | e}}{% else %}{{blog_info.name | e}}{% endif %}</h1>
    {%- include "post/notes/viewer/" + note_type + ".jinja" %}
{% endblock %}